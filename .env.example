# =========================================================
# AML Network Intelligence — Environment variables
# Copy this file to .env and fill in real values.
# =========================================================

# ---- Project ----
PROJECT_NAME=aml-network-intelligence
ENVIRONMENT=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# ---- Paths ----
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
FEATURES_DIR=./data/features
MODELS_DIR=./models
REPORTS_DIR=./reports

# ---- Kaggle ----
# Get your token at: https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# ---- MLflow ----
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=aml-network-intelligence
MLFLOW_MODEL_NAME=aml-xgb-classifier

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# ---- Model serving ----
MODEL_PATH=./models/xgb_model.ubj
SCALER_PATH=./models/scaler.pkl

# ---- Monitoring ----
DRIFT_THRESHOLD=0.15
MONITORING_WINDOW_DAYS=7
